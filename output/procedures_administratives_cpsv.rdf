    <dct:title xml:lang="ar">نسخ من عقود العمل المبرمة بين الشركة ومستخدميها موقعين ومصادق عليهم من قبل الطرفين</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04438">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
