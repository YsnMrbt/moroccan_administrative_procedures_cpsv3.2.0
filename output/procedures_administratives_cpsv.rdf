    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00631</dct:identifier>
    <dct:title xml:lang="ar">الرخص أو وصولات التصريحات المتعلقة بإنشاء أو نقل المؤسسات المترتبة المنصوص عليها في التشريع المتعلق بالمؤسسات غير الصحية أو غير الملائمة أو الخطيرة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

