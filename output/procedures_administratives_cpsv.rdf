    <dct:title xml:lang="ar">‌ح) تبين قدرة الإنتاج ( يومية أو سنوية أو هما معا) و التخزين المرتقبة؛</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
