  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01576">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01576</dct:identifier>
    <dct:title xml:lang="ar">الموافقة المسبقة المتعلقة بعلاجات الاسنان بعيادات القطاع الخاص CNOPS</dct:title>
    <dct:description xml:lang="ar">الموافقة المسبقة على علاجات الأسنان قصد إخبار المستفيد عن التعويض قبل إنجاز العمل الطبي وتسديد المصاريف. بالنسبة للأعمال الطبية التالية: • بالنسبة لجسر الأسنان (Bridges ) الذي يتجاوز ثلاثة أسنان؛ • بالنسبة لتجديد الأجهزة التعويضية الثابتة (renouvèlement de prothèses fixes )؛ • بالنسبة لتركيبات الأسنان(Stellites) التي تضم أقل من 4 أسنان وتتجاوز 10 أسنان؛ • بالنسبة للأسدس الأول لتقويم الأسنان ODF. ملاحظة: قائمة علاجات الاسنان التي تستدعي الحصول على الموافقة المسبقة ليست نهائية، ويمكن تعديلها وفق برنامج تدبير المخاطر المنجز من طرف الصندوق الوطني لمنظمات الاحتياط الاجتماعي.  وذلك وفقا للشروط التالية  * أحقية الاستفادة من خدمات التأمين الإجباري الأساسي عن المرض لفائدة المؤمن او دوي حقوقه  * إيداع طلب يتضمن الوثائق الطبية والإدارية  * أن تكون العلاجات مبررة طبيا</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/87a96a4a-06ac-4bfa-b533-a26e4bb4fb33/a340a5f4-4670-4491-9e05-7254ac0eaa8f"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
