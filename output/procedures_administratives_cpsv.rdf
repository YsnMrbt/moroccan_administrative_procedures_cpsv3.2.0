    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD06613</dct:identifier>
    <dct:title xml:lang="ar">بيان التصريح بالأجور لدى الصندوق الوطني للضمان الاجتماعي لكل شخص من الاشخاص المقترحين لإجراء المراقبة منذ بداية تصريحه بالصندوق، و يعفى من تقديم هذه الوثيقة كل شخص لا يحمل صفة أجير ورد إسمه في النظام الأساسي للمختبر أو ضمن لائحة المسيرين المبينة في السجل التجاري أو في محضر اجتماع الجمعية العامة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

