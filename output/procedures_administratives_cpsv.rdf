  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01893">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01893</dct:identifier>
    <dct:title xml:lang="ar">صفة المتعامل الاقتصادي المعتمد صنف ”السلامة و الأمن”</dct:title>
    <dct:description xml:lang="ar">الغاية من هذه المسطرة: - مواكبة تطورالنسيج الاقتصادي الوطني لأجل تأطيره و تأهيله على جميع الأصعدة ؛  - تنمية وتطوير الثقافة التشاركية مع القطاع الخاص ؛  - تقوية التعاون مع الإدارات الجمركية الشريكة. كما تستفيد الشركات الحاصلة على رخصة صفة الفاعل الاقتصادي المعتمد صنف ”السلامة و الأمن” من مجموعة من التسهيلات الجمركية تمكنها من تبسيط و إنجاز العمليات التجارية في ظروف ملائمة. تستفيد من هذه الرخصة جميع الشركات المقيمة بمجموع التراب الوطني كيفما كان حجمها والتي تمارس أنشطة صناعية أو تجارية أو خدماتية ذات الصلة بالتجارة الدولية لمدة لا تقل عن 3 سنوات ،و الحاصلة على صفة المتعامل الاقتصادي المقبول صنف ” تبسيطات جمركية صنف أ”، شريطة احترام المعايير التالية :  - خلو سجل الشركة من خروقات خطيرة ؛ - التوفر على نظام فعال لحفظ السجلات؛ - القدرة على الوفاء بالالتزامات المالية ؛ - التوفر على معايير ملائمة للأمن و السلامة.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/f3a7c338-8c2a-4f7b-909a-13f27caa394d"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00006"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07141"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07142"/>
    <cpsv:produces rdf:resource="http://procedures_administratives_cpsv.ma/id/output/OTPT001841"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_562f610f6426"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_562f610f6426"/>
