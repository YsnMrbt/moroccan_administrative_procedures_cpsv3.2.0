    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01591</dct:identifier>
    <dct:title xml:lang="ar">تحمل علاجات الأسنان بعيادات طب الأسنان التابعة للتعاضديات CNOPS</dct:title>
    <dct:description xml:lang="ar">تحمل علاجات الاسنان في إطار نظام الثالث المؤدي على مستوى عيادات طب الأسنان التابعة للأعمال الاجتماعية للتعاضديات، قصد تسهيل ولوج المرتفقين لخدمة تركيب أطقم الأسنان الاصطناعية، وعملية تقويم الاسنان للأطفال، وذلك وفق الشروط التالية:  * أحقية الاستفادة من خدمات التأمين الإجباري الأساسي عن المرض لفائدة المؤمن أو ذوي حقوقه  * إيداع ملف طلب التحمل المباشر لعلاجات الأسنان  * العلاجات المبررة طبيا  * انضمام عيادة طب الأسنان التابعة للتعاضدية لنظام الثالث المؤدي</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/87a96a4a-06ac-4bfa-b533-a26e4bb4fb33/52bec70b-db6c-46df-b17a-140357ab5737"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
