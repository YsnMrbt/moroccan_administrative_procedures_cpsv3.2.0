    <cpsv:produces rdf:resource="http://procedures_administratives_cpsv.ma/id/output/OTPT001865"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_562f610f6426"/>
