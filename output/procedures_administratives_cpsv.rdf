    <dct:title xml:lang="ar">قائمة محينة للأشخاص المقترحين للمراقبة و السير الذاتية المحينة الخاصة بهم.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

