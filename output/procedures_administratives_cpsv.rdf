  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01920">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01920</dct:identifier>
    <dct:title xml:lang="ar">منح الإعفاء أو التخفيض من فوائد التـأخير وصوائر التحصيل</dct:title>
    <dct:description xml:lang="ar">- تشجيع الصلح والتحصيل التلقائي بشكل عام، وكذا مواكبة الفاعلين الاقتصاديين وقت الأزمات والظرفيات الاقتصادية الصعبة. - يشترط للحصول على الإعفاء الجزئي أو الكلي من أداء فوائد التـأخير وصوائر التحصيل الجبري، أداء أصل الدين من طرف المعني بالأمر، وتقديم هذا الأخير لطلب يعرض من خلاله الأسباب الكامنة وراء تأخره أو تعثره في أداء ما بذمته.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/eeda74dd-cba4-4cd3-a87f-1f2afd0bc1d8"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00006"/>
    <cpsv:produces rdf:resource="http://procedures_administratives_cpsv.ma/id/output/OTPT001868"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_636775641b86"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_636775641b86"/>
    <cv:processingTime rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">P0D</cv:processingTime>
    <cv:hasCost rdf:resource="http://procedures_administratives_cpsv.ma/id/cost/COST01920"/>
    <cv:sector rdf:resource="http://procedures_administratives_cpsv.ma/id/concept/sector/sec_sub_6808a66596ec"/>
