  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01276">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01276</dct:identifier>
    <dct:title xml:lang="ar">وصل إيداع ملفات تأسيس التعاونيات</dct:title>
    <dct:description xml:lang="ar">تقدم وزارة الداخلية هذه الخدمة لفائدة المغاربة المقيمين بالمغرب أو بالخارج، والأجانب المقيمين بالمغرب، والمستثمرين، والمقاولات، والمهنيين، والتعاونيات، وذلك بغاية إخبار السلطة الإدارية المحلية بمسطرة تأسيس التعاونية. ويشترط إيداع الوثائق المطلوبة المنصوص عليها في المادة 11 من القانون رقم 112.12 المتعلق بتأسيس التعاونية للحصول على هذا القرار الإداري</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/f098d7d4-2268-4f82-b23f-d742deb398c2/806f1619-af6f-4630-af6e-77a4c8e25b16"/>
