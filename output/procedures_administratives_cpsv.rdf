    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04504</dct:identifier>
    <dct:title xml:lang="ar">التزام موقع من طرف صاحب الطلب يلتزم فيه باحترام أحكام مدونة الشغل.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04505">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04505</dct:identifier>
    <dct:title xml:lang="ar">مشاريع عقود العمل موقعة من طرف المشغل وكل شخص مقترح للقيام بالمراقبة مرفقة بالتزام صاحب الطلب بتقديم، في غضون ثلاثين (30) يوما من تاريخ الإشعار بمنح الاعتماد، عقود العمل النهائية موقعة من الطرفين.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

