  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01597">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01597</dct:identifier>
    <dct:title xml:lang="ar">التحمل المباشر للخدمات المضمونة في إطار الثالث المؤدي مع مقدمي الخدمات الطبية CNOPS</dct:title>
    <dct:description xml:lang="ar">منح الموافقة على التحمل المباشر من طرف الصندوق الوطني و.م.ح.ج، لفائدة مقدمي الخدمات الطبية نيابة عن المؤمن أو ذوي حقوقه قصد إعفاء هذا الأخير من الأداء المسبق لمصاريف العلاج وذلك وفق نسب تغطية الخدمات الطبية والتعريفة المرجعية الوطنية المحددة بموجب الاتفاقيات الوطنية، وذالك وفق الشروط التالية:   * أحقية الاستفادة من الخدمات المضمونة برسم نظام التأمين الإجباري الأساسي عن المرض لفائدة المؤمن وذوي حقوقه  * حصول مقدم الخدمات الطبية على الرقم الوطني الاستدلالي لمهنيي الصحة INPE وفق المسطرة الجاري بها العمل  * انضمام مقدم الخدمات الطبية الى نظام الثالث المؤدي  * إيداع طلب التحمل المباشر من قبل مقدم الخدمات الطبية لدى الصندوق، يتضمن الوثائق الإدارية والطبية المطلوبة  * العلاجات المبررة طبيا يتم تقديم الطلب عبر المنصة الإلكترونية : http://www.cnops.org.ma/tiers_app_login</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/87a96a4a-06ac-4bfa-b533-a26e4bb4fb33/d07488a8-1615-43aa-af60-0c1c88f0c002"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00005"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD06145"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD06146"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD06147"/>
    <cpsv:produces rdf:resource="http://procedures_administratives_cpsv.ma/id/output/OTPT001548"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_3cc054f80685"/>
