    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD06612</dct:identifier>
    <dct:title xml:lang="ar">نسخة من كل وثيقة تساعد على تقييم الأهلية النظرية و العملية للأشخاص المقترحين لإجراء المراقبة و الخبرة و التجربة المكتسبتين في مجال قياس الغبار في أماكن العمل، لا سيما المراجع و شهادات التوصية المتعلقة بأنشطة سابقة لكل واحد منهم</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD06613">
