  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01596">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01596</dct:identifier>
    <dct:title xml:lang="ar">الموافقة المسبقة للتعويض عن مصاريف علاجات الأسنان (Expertise)</dct:title>
    <dct:description xml:lang="ar">الموافقة المسبقة للصندوق الوطني للضمان الاجتماعي على طلب تسديد المصاريف المتعلقة بعلاجات الأسنان. يخضع هذا القرار لمقتضيات المرسوم رقم 2.22.386 بتحديد لائحة القرارات الإدارية التي تقتضي معالجة الطلبات المتعلقة بها تمديد الأجل القانوني المحدد لتسليمها، لإنجاز خبرة تقنية أو بحث عمومي.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/87a96a4a-06ac-4bfa-b533-a26e4bb4fb33/f4ec0654-802e-4e42-8879-fe73ce5a1469"/>
