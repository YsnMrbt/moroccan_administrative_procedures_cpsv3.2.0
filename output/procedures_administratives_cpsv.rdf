  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS00866">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS00866</dct:identifier>
    <dct:title xml:lang="ar">رخصة فتح مستودع صناعي حر</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة الشركات من الحصول على رخصة فتح مستودع صناعي حر الذي يمكن من استيراد و اقتناء مع وقف استيفاء الرسوم والمكوس للمعدات والتجهيزات وأجزاؤها وقطعها المنفصلة و البضائع المعدة لاستعمالها في المعدات والتجهيزات المذكورة.   للحصول على هذه الرخصة يجب تحقيق استثمار يساوي مبلغه الأدنى 50.000.000 درهم في إطار إحداث منشآت أو توسيعها و بعد استطلاع رأي القطاع الوزاري المكلف بالمورد.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/83313be3-7225-46a3-9abe-1aeecb72d853"/>
