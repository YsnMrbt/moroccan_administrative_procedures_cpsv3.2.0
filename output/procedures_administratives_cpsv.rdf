    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00552">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00552</dct:identifier>
    <dct:title xml:lang="ar">مذكرة تبين على الخصوص الدراسات المنجزة و الأشغال التي تم تنفيذها و نتائج الدراسات و الأشغال المذكورة و تفسيراتها، و الوثائق المثبتة للنفقات التي تم صرفها</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
