    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04432">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04432</dct:identifier>
    <dct:title xml:lang="ar">تقرير مفصل عن العمل موقع ومختوم لفترة الاعتماد الأخيرة مع تحديد على وجه الخصوص : تاريخ ، ومكان وهوية الموظف الذي يقوم بالمراقبة بالإضافة إلى المعلومات المتعلقة بالأجهزة الخاضعة للمراقبة (المالك ، تعريف الآلة والشركة المصنعة ورقم وسنة الصنع)</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
