    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00319">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00319</dct:identifier>
    <dct:title xml:lang="ar">مراقبة عدم إعادة الزواج: - تصريح بالشرف بعدم إعادة الزواج منذ تاريخ وفاة الهالك(ة) مؤرخ ويحمل توقيع الأرملة (الأرمل) - نسخة من البطاقة الوطنية للتعريف - شهادة التعريف البنكي أو شيك ملغى (في حالة الأداء عن طريق حوالة بنكية).</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00320">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00320</dct:identifier>
    <dct:title xml:lang="ar">حالة المعاشات الموقوف صرفها بسبب مراقبة التمدرس: - شواهد مدرسية برسم السنوات المطلوبة (بالنسبة للأبناء المتراوحة أعمارهم ما بين 16 و21 سنة - شهادة التعريف البنكي او شيك ملغى (في حالة الأداء عن طريق حوالة البنكية</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00321">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00321</dct:identifier>
    <dct:title xml:lang="ar">حالة المعاشات الموقوف صرفها بسبب مراقبة الدخل: - شهادة الدخل مسلمة من طرف المديرية العامة للضرائب برسم السنوات الخاضعة للمراقبة (نموذج 4169 ) - شهادة التعريف البنكي أو شيك ملغى (في حالة الأداء عن طريق حوالة بنكية).</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00322">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00322</dct:identifier>
    <dct:title xml:lang="ar">حالة المعاشات الموقوف صرفها بسبب مراقبة عجز الأبناء أو الأيتام: - طلب خطي مؤرخ يحمل توقيع المعني(ة) بالأمر، رقم الهاتف ورقم المعاش ا؛ - نسخة من البطاقة الوطنية للتعريف للوصي. - ملف طبي يخص المعاق مكون من: - -تقرير طبي مصادق عليه من طرف اللجنة الطبية الإقليمية التابع لها مقر إقامة المعاق؛ - - فحص طبي مضاد مصادق عليه من طرف المجلس الصحي الإقليمي التابع له مقر إقامة المعاق - تصريح بالشرف بالعزوبة مؤرخ ويحمل توقيع المعني بالأمر -تصريح بالشرف بعدم العمل مؤرخ ويحمل توقيع المعني بالأمر</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

