  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01228">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01228</dct:identifier>
    <dct:title xml:lang="ar">تسجيل شركة التوصية بالأسهم بالسجل التجاري</dct:title>
    <dct:description xml:lang="ar">التسجيل بالسجل التجاري وفق المقتضيات المنصوص عليها قانونا، لكون المشرع ووفق المادة 37 من مدونة التجارة جعل التسجيل بالسجل التجاري أمرا إلزاميا على جميع التجار الذاتيين والاعتباريين مغاربة كانوا أو أجانب الذين يمارسون نشاطا تجاريا في تراب المملكة. هذا بالإضافة إلى أن الشخصية المعنوية للشركات لا تكتسب إلا منذ تاريخ التسجيل في السجل التجاري ـــ مع الأخذ بعين الاعتبار أن شركات المحاصة لا تسجل بالسجل التجاري ولا تتمتع بالشخصية المعنويةـــ في إطار المراقبة التي يجريها كاتب الضبط للوثائق والمستندات المقدمة إليه-في غير الحالات التي يجب فيها قانونا الاحتفاظ بأصول الوثائق- يتعين على المرتفق الإدلاء بأصل الوثيقة ويتولى كاتب الضبط أمر نسخها وإرجاعها فورا إلى المعني بالأمر. وبالنسبة للتوقيع على التصاريح والعقود والوثائق الخاضعة لهذا الإجراء يجب أن يتم أمام كاتب الضبط الذي يشير بنفس الوثيقة إلى اسم الموقع ورقم بطاقته الوطنية وصفته مع وضع طابع المحكمة وتوقيع كاتب الضبط</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/f098d7d4-2268-4f82-b23f-d742deb398c2/3d890672-654d-44e6-b5c0-480f8a02f41c"/>
