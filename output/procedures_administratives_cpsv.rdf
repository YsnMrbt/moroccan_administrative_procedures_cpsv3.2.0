    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04445">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04445</dct:identifier>
    <dct:title xml:lang="ar">شهادة مسلمة من مؤسسة جامعية أو مدرسة وطنية أو شهادة معادلة طبقا للنصوص التشريعية و التنظيمية الجاري بها العمل</dct:title>
