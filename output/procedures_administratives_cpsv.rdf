    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07137"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07261"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07262"/>
