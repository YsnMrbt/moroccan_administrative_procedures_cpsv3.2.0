    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04494</dct:identifier>
    <dct:title xml:lang="ar">وثائق تثبت الإجابة على الملاحظات الواردة في تقرير مهمة التدقيق</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

