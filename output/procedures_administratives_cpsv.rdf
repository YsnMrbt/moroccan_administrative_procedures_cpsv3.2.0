  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01914">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01914</dct:identifier>
    <dct:title xml:lang="ar">ترخيص العرض للاستهلاك للسيارات المرقمة بالخارج في إطار المتلاشيات</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة من تسوية وضعية السيارات المستوردة تحت نظام القبول المؤقت و ذلك عبر العرض للاستهلاك في إطار المتلاشيات.   و للحصول على هذا الترخيص يتعين الإدلاء بالوثائق اللازمة خصوصا محضر معاينة الحادثة مسلم من طرف السلطات المعنية أو شهادة المعاينة الودية للحادثة بالنسبة للسيارات التي تعرضت لحادثة أو شهادة عدم القبول الفحص التقني مسلمة من مصالح وكالة نارسا بالنسبة للسيارات الغير صالحة للجولان و تقرير الخبرة.   و تجدر الإشارة أن الاستفادة من هذه الرخصة يتم مقابل قطع محاور السيارات و سحب البطاقة الرمادية و ذلك دون منح شهادة التعشير للسيارة المعنية.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/b302096f-37d8-4a37-92fa-c8bc3d5551fc"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
