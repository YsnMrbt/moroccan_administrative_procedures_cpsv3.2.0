  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD06585">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD06585</dct:identifier>
    <dct:title xml:lang="ar">نسخة من كل وثيقة تساعد على تقييم الأهلية النظريــة والعملية للأشخاص الجدد المقترحين لإجراء المراقبة، والخبرة والتجربة المكتسبتين في مجال قياس الغبار في أماكن الشغل، لا سيما المراجع وشهادات التوصية المتعلقة بأنشطة سابقة لكل واحد منهم</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD06586">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD06586</dct:identifier>
    <dct:title xml:lang="ar">نسخة من عقود الشغل التي تربط الأشخاص الجدد المقترحين لإجراء المراقبة بالمختبر ويعفى من ذلك كل شخص لا يحمل صفة أجير ورد اسمه في النظام الأساسي للمختبر أو ضمن لائحة المسيرين المبينة في السجل التجاري أو في محضر اجتماع الجمعية العامة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

