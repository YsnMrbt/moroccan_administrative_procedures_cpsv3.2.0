    <dct:title xml:lang="ar">نسخة من النظام الأساسي للشخص الاعتباري وآخر محضر للجمعية العامة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD01082">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD01082</dct:identifier>
    <dct:title xml:lang="ar">استمارة الطلب معبأة من طرف صاحب الطلب</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD01083">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD01083</dct:identifier>
    <dct:title xml:lang="ar">نسخة من الورقة الرمادية للمركبة المستعملة كسيارة للأجرة في إسم صاحب الطلب</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
