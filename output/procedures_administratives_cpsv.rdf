  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01892">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01892</dct:identifier>
    <dct:title xml:lang="ar">ترخيص القبول المؤقت للسيارات من طرف التقنيين المقيمين مؤقتا بالمغرب لإنجاز مشاريع من طرف الدولة</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة التقنيين المقيمين مؤقتا بالمغرب لانجاز مشاريع من طرف الدولة من الاستفادة من القبول المؤقت للسيارات.  و للحصول على هذا الترخيص يتعين الإدلاء بالوثائق اللازمة لاسيما نسخة من الاتفاقية مصادق عليها من طرف المغرب تنص على منح نظام القبول المؤقت للسيارات لفائدة التقنيين و /أو الشركة المشغلة و شهادة مسلمة من طرف الادارة المغربية تنص على أن الشركة المشغلة تنجز أعمالا لحساب الدولة و شهادة مسلمة من طرف الشركة المشغلة مصادق عليه من طرف القطاع الوزاري بالمغرب ذي الصلة الخاص تنص على أن التقني المعني بالأمر ملحق بالمغرب في إطار إنجاز أعمال لحساب الدولة.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/f3edb7d4-d745-4e04-8f69-5cb24336ea55"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
