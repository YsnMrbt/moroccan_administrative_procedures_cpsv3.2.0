    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07248"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07249"/>
