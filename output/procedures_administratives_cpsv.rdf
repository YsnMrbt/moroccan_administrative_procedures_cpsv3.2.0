  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01927">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01927</dct:identifier>
    <dct:title xml:lang="ar">ترخيص القبول المؤقت للمعدات و الأدوات الباقية على ملكية أجنبية لإنتاج سلع موجهة للتصدير في حدود 75% منها على الأقل (Invest)</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة الشركات المصدرة من الاستيراد تحت نظام القبول المؤقت للمعدات و الأدوات الباقية ملكية أجنبية لإنتاج سلع موجهة للتصدير في حدود 75% منها على الأقل مع الإعفاء من أداء وجيبة الثلاثة أشهر.  يخضع هذا القرار لمقتضيات المرسوم رقم 2.22.385 بتحديد لائحة القرارات الإدارية اللازمة لإنجاز مشاريع الاستثمار التي لا يتجاوز أجل معالجة الطلبات المتعلقة بها وتسليمها 30 يوما.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/09d1dce8-9cbc-46bd-aadb-03a87bc7b3b1"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00006"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07264"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07265"/>
    <cpsv:produces rdf:resource="http://procedures_administratives_cpsv.ma/id/output/OTPT001875"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_636775641b86"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_636775641b86"/>
    <cv:processingTime rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">P15D</cv:processingTime>
    <cv:hasCost rdf:resource="http://procedures_administratives_cpsv.ma/id/cost/COST01927"/>
    <cv:sector rdf:resource="http://procedures_administratives_cpsv.ma/id/concept/sector/sec_sub_6808a66596ec"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01928">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01928</dct:identifier>
    <dct:title xml:lang="ar">الترخيص السنوي للقبول المؤقت للأعتدة الباقية على ملكية أجنبية لإنتاج سلع موجهة للتصدير في حدود 75% منها على الأقل (Invest)</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة الشركات المصدرة العاملة في الأنشطة ذات التقنية العالية )صناعة الطائرات و السيارات و الإلكترونيك ...إلخ (و كذا تلك المتوفرة على صفة الفاعل الاقتصادي المعتمد من الحصول على ترخيص سنوي للقبول المؤقت للأعتدة الباقية ملكية أجنبية لإنتاج سلع موجهة للتصدير في حدود 75% منها على الأقل مع الإعفاء من أداء وجيبة الثلاثة أشهر.  يخضع هذا القرار لمقتضيات المرسوم رقم 2.22.385 بتحديد لائحة القرارات الإدارية اللازمة لإنجاز مشاريع الاستثمار التي لا يتجاوز أجل معالجة الطلبات المتعلقة بها وتسليمها 30 يوما.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/3b09b5c4-5f2f-4082-ae47-838c84321c66"/>
