  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01830">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01830</dct:identifier>
    <dct:title xml:lang="ar">الترخيص من أجل استيراد الأدوية والمواد التي تدخل في نطاق المخدرات</dct:title>
    <dct:description xml:lang="ar">إصدار التراخيص من أجل استيراد الأدوية و المواد التي تدخل في نطاق المخدرات و المؤثرات العقلية و السلائف الكيميائية من أجل توفير احتياجات المغرب من هذه المواد ؛  مراقبة استخدامها من قبل القطاع الصيدلي من خلال الإحصائيات الفصلية و السنوية؛ . مهمة الصحة العامة من خلال التوفير و الاستعمال الرشيد لهذه المواد لأغراض طبية و علمية استيراد المستحضرات الصيدلية الموضوعة تحت المراقبة للأغراض الطبية والصيدلانية</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/aec53556-1fa2-43aa-8880-0563fb88c45c"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00002"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD06953"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD01311"/>
