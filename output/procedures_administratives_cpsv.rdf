  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/cost/COST00154">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Cost"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COST00154</dct:identifier>
    <cv:currency rdf:resource="http://publications.europa.eu/resource/authority/currency/MAD"/>
    <dct:description xml:lang="ar">تكملة التسبيق على الاستهلاك: في حالة الرفع من القدرة المكتتبة يدفع المرتفق تسبيقا على الاستهلاك مطابقا لقيمة القدرة الإضافية وتكون طريقة احتسابه متفقا عليها في عقد التزويدتحتسب وفق القوة المكتتبة و التعرفة المعتمدةالقوة المكتتبة و التعرفة المعتمدة</dct:description>
    <cv:isDefinedBy rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00018"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/cost/COST00155">
