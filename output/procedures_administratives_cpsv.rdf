  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01911">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01911</dct:identifier>
    <dct:title xml:lang="ar">ترخيص باكتتاب التصاريح المبسطة للقبول و التصدير المؤقتين لوسائل النقل التجارية D17/D20 بطريقة إلكترونية</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة الشركات المختصة في النقل الدولي من اكتتاب التصاريح المبسطة للقبول و التصدير المؤقتين لوسائل النقل التجاريةD17/D20 بطريقة إلكترونية عبر النظام المعلوماتي لإدارة الجمارك وفقا لمايلي : • اكتتاب التصاريح المبسطة للتصدير المؤقت بالنسبة للعربات ذات الترقيم الوطني، • اكتتاب التصاريح المبسطة للقبول المؤقت بالنسبة للعربات الاجنبية وفقا لعقد شراكة يربط هاته الشركات الوطنية بنظيرتها الاجنبية.. يتعين على الشركات التي تريد الاستفادة من هذه المسطرة ادراج رقم سجلها التجاري ضمن النظام المعلوماتي للجمارك و التوفر على الاليات التقنية اللازمة من اجل الولوج اليه توقيع التصاريح الكترونيا ضمنه. و يسمح في هذا الاطار بتوكيل معشر معتمد من قبل الجمارك للقيام بهاته الاجراءات مقابل تفويض وفق المقتضيات القانونية في هذا الاطار</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/ddecb19a-5021-47e6-bb78-9da07ecfe38f"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00006"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07190"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07217"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07218"/>
