    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD06136"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD06137"/>
