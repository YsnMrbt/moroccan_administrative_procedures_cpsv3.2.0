    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07203"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07189"/>
    <cpsv:produces rdf:resource="http://procedures_administratives_cpsv.ma/id/output/OTPT001853"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_636775641b86"/>
