    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD03691">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD03691</dct:identifier>
    <dct:title xml:lang="ar">3-  كتاب الإجراءات يستند على دليل أو دلائل الممارسات الصحية الجيدة المتعلقة بالنشاط المعني. وفي حالة عدم وجود هذه الدلائل، يجب إعداد الكتاب، مع الأخذ بعين الاعتبار، بالنسبة لكل نشاط معني، ما يلي:</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD03692">
