  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01600">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01600</dct:identifier>
    <dct:title xml:lang="ar">استرداد مصاريف الأدوية بالنسبة للصيادلة (Expertise)</dct:title>
    <dct:description xml:lang="ar">الغاية : استرداد مصاريف الأدوية التي يتم تحملها في إطار نظام الثالث المؤدي بالنسبة للصيادلة. يخضع هذا القرار لمقتضيات المرسوم رقم 2.22.386 بتحديد لائحة القرارات الإدارية التي تقتضي معالجة الطلبات المتعلقة بها تمديد الأجل القانوني المحدد لتسليمها، لإنجاز خبرة تقنية أو بحث عمومي.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/87a96a4a-06ac-4bfa-b533-a26e4bb4fb33/b214f62b-df9a-4e65-b9b0-30de033370ee"/>
