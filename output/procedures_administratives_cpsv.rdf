  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD02068">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD02068</dct:identifier>
    <dct:title xml:lang="ar">قرار الموافقة البيئية المنصوص عليه في المادة 7 من القانون رقم 12.03 المتعلق بدراسة التأثير على البيئة شريطة أن تشتمل الدراسة المذكورة على جزء يتعلق بالنفايات كيفما كانت طبيعتها المتأتية من مزرعة تربية الأحياء البحرية والمتضمنة على الخصوص أنواع النفايات الناتجة عن هذه المزرعة و آثارها على الوسط و النظام البيئي البحريين و طرق التقييم المستعملة لقياس هذه الآثار و الإشارة، إن اقتضى الحال، إلى كل الإجراءات و الطرق المرتقبة لتقليص و قع هذا الآثار</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

