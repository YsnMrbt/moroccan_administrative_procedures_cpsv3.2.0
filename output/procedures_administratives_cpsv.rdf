  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS00012">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS00012</dct:identifier>
    <dct:title xml:lang="ar">التحمل المباشر بالمؤسسات الطبية التربوية CNOPS</dct:title>
    <dct:description xml:lang="ar">التحمل المباشر لمصاريف خدمات المساعدة الطبية التربوية في إطار نظام الثالث المؤدي، لفائدة الأطفال ذوي الاحتياجات الخاصة وذلك وفق الشروط التالية :   * أحقية الاستفادة من خدمات التأمين الإجباري الأساسي عن المرض لفائدة المؤمن وذوي حقوقه  * استفادة الطفل في وضعية إعاقة قبل بلوغه سن 12 سنة إلى غاية بلوغه سن 21 سنة  * انضمام المركز الطبي التربوي الى نظام الثالث المؤدي   * تقديم طلب التحمل المباشر من قبل المؤسسة الطبية التربوية الى الصندوق، يتضمن الوثائق الإدارية والطبية</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/015a099a-25d2-451b-bf06-e255145bb20f/ed3ffc97-6674-46c0-9ba8-a30ef37d03af"/>
