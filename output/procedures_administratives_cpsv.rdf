    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04435">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04435</dct:identifier>
    <dct:title xml:lang="ar">التزام موقع ومختوم من طرف الشركة، لاحترام مقتضيات الدورية الوزارية رقم 2456 المؤرخة في 02/12/2005، مع التأكيد على أن الشركة ومستخدميها الذين تستخدمهم لا ينبغي أن يشاركوا بشكل مباشر أو غير مباشر في تصميم أو إنتاج أو تسويق أو استخدام أو تشغيل أو صيانة الآلات التي قد تخضع لمراقبتهم.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04436">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04436</dct:identifier>
    <dct:title xml:lang="ar">نسخ للديبلومات والشهادات المحصل عليها لكل شخص مقترح للقيام بالمراقبة.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

