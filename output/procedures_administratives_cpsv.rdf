    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD03688</dct:identifier>
    <dct:title xml:lang="ar">ن) تبين الرسم البياني المفصل لعملية الإنتاج؛</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

