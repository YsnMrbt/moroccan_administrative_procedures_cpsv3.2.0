  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01647">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01647</dct:identifier>
    <dct:title xml:lang="ar">شهادة البيع الحر للمكملات الغذائية</dct:title>
    <dct:description xml:lang="ar">منح إطار مناسب لتنظيم أنشطة صناعة المواد الغذائية و المشروبات لنظام غدائي خاص و المكملات الغذائية واستيرادها وتصديرها. و تقييم طلبات تسجيل هذه المواد</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/c5d867e8-651c-4825-a89f-a221372d1447"/>
