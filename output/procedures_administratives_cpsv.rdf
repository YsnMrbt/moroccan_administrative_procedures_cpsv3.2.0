    <dct:title xml:lang="ar">الخصائص التقنية للآلات التي يجب أن تجهز بها المنشآت</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00613">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
