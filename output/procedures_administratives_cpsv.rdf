  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01620">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01620</dct:identifier>
    <dct:title xml:lang="ar">شهادة انخراط مؤسسات التعليم العالي والتكوين المهني CNOPS</dct:title>
    <dct:description xml:lang="ar">تأكيد انخراط المؤسسة في نظام التأمين الاجباري الأساسي عن المرض الخاص بالطلبة لتمكينها من تسجيل الطلبة التابعين لها، مع ضرورة استيفاء الشروط المحددة في المادة 3 من القانون 12-116 والمادة 3 من المرسوم رقم 657-15-2 والتواجد ضمن لائحة المؤسسات المحددة بموجب قرارات وزارية كما تم تعديلها. ويستفيد من هذا القرار الشخص المعنوي الخاضع للقانون العام أو الخاص المشار إليه في المادة 13 من ق. رقم 116.12</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/87a96a4a-06ac-4bfa-b533-a26e4bb4fb33/277bde3b-bc29-47f8-bebb-97036ecfd288"/>
