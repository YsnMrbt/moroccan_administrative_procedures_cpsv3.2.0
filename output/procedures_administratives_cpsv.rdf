  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01901">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01901</dct:identifier>
    <dct:title xml:lang="ar">ترخيص القبول المؤقت للسيارات مع الترقيم في السلسلة الخاصة للنظام المؤقت (R.T) للأعوان و المتعاونين الذين تم توظيفهم خارج المغرب من طرف المؤسسات العمومية المغربية في إطار اتفاقية التعاون التقني المبرمة مع المغرب</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة الأعوان و المتعاونين الذين تم توظيفهم خارج المغرب من طرف المؤسسات العمومية المغربية في إطار اتفاقية التعاون التقني المبرمة مع المغرب من الاستفادة من القبول المؤقت للسيارات مع الترقيم السلسلة الخاصة للنظام المؤقت (R.T).   و للحصول على هذا الترخيص يتعين الإدلاء بالوثائق اللازمة لاسيما نسخة من اتفاقية التعاون الموقع عليها من طرف المغرب مع البلد الاجنبي المعني و شهادة الوزارة المعنية بالتوظيف و شهادة صادرة عن سفارة البلد الاجنبي المعني بالرباط تثبت التوظيف خارج المغرب.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/8677da00-a37d-470c-9512-e29d8200dc91"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00006"/>
