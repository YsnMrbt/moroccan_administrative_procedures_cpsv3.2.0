    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD05568">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD05568</dct:identifier>
    <dct:title xml:lang="ar">شهادة التعشير تحمل اسم المالك الجديد للمركبة والذي يجب أن تنجز البطاقة الرمادية في اسمه. غير أنه إذا كانت شهادة التعشير تحمل اسم شركة تثبت ممارسة نشاط استيراد المركبات ذات محرك بناء على شهادة القيد في السجل التجاري فإنه يعتد بشهادة التعشير لطلب تسجيل المركبة في اسم شخص آخر</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD05569">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD05569</dct:identifier>
    <dct:title xml:lang="ar">عقد بيع بالمصارفة منجز من طرف مؤسسة التمويل يحمل توقيعات البائع والمشتري ومؤسسة التمويل إذا تم شراء المركبة بقرض أو عقد بيع بالمرابحة لاقتناء المركبة مشفوعا بعقد اقتناء هذه المركبة مبرم بين البائع وأحد البنوك التشاركية أو غيرها من مؤسسات الائتمان أو الهيئات المعتبرة في حكمها "المعتمدة لتقديم منتجات المالية التشاركية"، إذا تم شراء المركبة في إطار عقد المرابحة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

