  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD05121">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD05121</dct:identifier>
    <dct:title xml:lang="ar">نسخة من كشف الإبحار معتمد يثبت قيام المرشح بخدمة بحرية معتمدة على متن السفن المجهزة بآلات دفع رئيسية تعادل أو تفوق 750 كيلو واط وذلك لمدة : • ستة وثلاثين (36) شهرا بصفة ضابط مسؤول عن الخفارة الهندسية بقسم محركات مطقمة أو غير خاضعة لإشراف دائم، أو ؛ • أربعة وعشرين (24) شهرا على المستوى الإداري أو المستوى التشغيلي بقسم المحركات، بما في ذلك فتره لا تقل عن إثنتا عشر (12) شهرا بصفة ضابط مهندس ثان.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

