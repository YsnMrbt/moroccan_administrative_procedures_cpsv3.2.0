  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01593">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01593</dct:identifier>
    <dct:title xml:lang="ar">التحمل المباشر للأدوية في إطار الثالث المؤدي عبر الصيدلياتCNOPS</dct:title>
    <dct:description xml:lang="ar">التحمل المباشر لمصاريف الأدوية الموصوفة للمؤمن قصد إعفاء هذا الأخير من الأداء المسبق لمصاريف العلاج، وذلك وفق الثمن المرجعي ونسب التعويض المعمول بها، وذالك وفق الشروط التالية:    * أحقية الاستفادة من الخدمات المضمونة في إطار نظام التأمين الإجباري الأساسي عن المرض لفائدة المؤمن وذوي حقوقه  * إصابة المؤمن او ذوي حقوقه بمرض طويل الأمد او باهض الثمن   * أن تكون الادوية مدرجة في الاتفاقية المبرمة بين الصندوق والصيادلة  * أن يكون المرض المزمن مماثل للأدوية الموصوفة والمدرج في القرار الوزاري  * انضمام الصيدلية الى نظام الثالث المؤدي  * حصول الصيدلية على الرقم الوطني الاستدلالي لمهني الصحة INPE وفق المسطرة الجاري بها العمل  * إيداع طلب التحمل من قبل المؤمن</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/87a96a4a-06ac-4bfa-b533-a26e4bb4fb33/c5e44fcc-a99b-4f27-8a75-8a59515d5440"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
