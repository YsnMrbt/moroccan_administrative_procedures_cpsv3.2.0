    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04111</dct:identifier>
    <dct:title xml:lang="ar">2- خريطة مرسوم فيها بمزيد التدقيق موقع المحل يكون أقل مقياسها سنتمترين اثنين (هكذا 02 0) لكل ميتر وتكون دالة على حدود المكان المراد إشغاله وعلى اسم المسالك المجاورة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

