  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01925">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01925</dct:identifier>
    <dct:title xml:lang="ar">رخصة اعتماد طابع الصائغ</dct:title>
    <dct:description xml:lang="ar">الهدف من المسطرة هو السماح للصاغة من وضع طابع تعريفي يطلق عليه اسم "طابع الصائغ" لتمييز المصوغات بينها، و يمكن أن يكون على شكل حروف أو أرقام أو كلمات أو رسومات بيانية أو شعارات، منفردة أو مركبة. لا يمكن لهذا الطابع أن يشبه أو يطابق الطوابع الرسمية أو الطوابع المسجلة من طرف صائغين آخرين أو علامات التجارة أو الصنع المسجلة من طرف أشخاص آخرين غير الطالب، أو مختصرات لمنظمات دولية.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/691b009d-acaf-45bd-91a2-9c7159460bba"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00006"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07258"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07259"/>
