  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01913">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01913</dct:identifier>
    <dct:title xml:lang="ar">ترخيص القبول المؤقت مع الترقيم في السلسلة الخاصة للنظام المؤقت (R.T) للسيارات المملوكة للمدرسين الملحقين بمدارس البعثات الاجنبية الخاصة بكل من فرنسا وإسبانا و إيطاليا و بلجيكا</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة المدرسين الملحقين بمدارس البعثات الاجنبية الخاصة بكل من فرنسا وإسبانا و إيطاليا و بلجيكا من الاستفادة من القبول المؤقت للسيارات مع الترقيم في السلسلة الخاصة للنظام المؤقت (R.T).    و للحصول على هذا الترخيص يتعين الإدلاء بالوثائق اللازمة لاسيما نسخة من الاتفاقية المبرمة مع الدولة المعنية عند الاقتضاء و شهادة التوظيف مسلمة من قبل سفارة بلد المعني بالرباط و نسخة من قرار الا لحاق بمدارس البعثات الاجنبية بالمغرب</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/11f298de-9718-4bd2-9ff7-ab1579bb15d3"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
