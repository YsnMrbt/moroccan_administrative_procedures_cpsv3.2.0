    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD07584</dct:identifier>
    <dct:title xml:lang="ar">نسخة من الديبلومات المسلمة لخريجي المؤسسة وفق النماذج التي اعتمدتها الوزارة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD07585">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD07585</dct:identifier>
    <dct:title xml:lang="ar">نسخ من المحاضر الجماعية للجن المداولات لكل السنوات الدراسية. يحمل كل محضر الطابع الرسمي للمؤسسة وتاريخ إنجاز هذا المحضر وتوقيعات منسق المسلك ومنسقي الوحدات والأساتذة أعضاء لجنة المداولات والمدير التربوي للمؤسسة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD07586">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD07586</dct:identifier>
    <dct:title xml:lang="ar">بالنسبة للطلبة الخريجين في ميدان علوم الصحة: نسخ من شهادات جميع التداريب المنجزة من طرف كل خريج والمحددة في دفتر التحملات الخاصة بكل مسلك. وتحدد في هذه الشهادة خصوصا النقط التالية: - الاسم الكامل للطالب، - إسم مسلك التكوين - السنة الجامعية والمستوى الدراسي المسجل به، - مكان ومدة التداريب المنجزة وفقا لتلك المحددة في البرامج الدراسية المرخص للمؤسسة بتنظيمها من طرف الوزارة. يجب أن توقع شهادات التداريب المنجزة إما من طرف رئيس المصلحة التي أجري بها التدريب أو من طرف الطبيب الرئيس أو مدير المستشفى مع تبيان إسم وصفة الموقع</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

