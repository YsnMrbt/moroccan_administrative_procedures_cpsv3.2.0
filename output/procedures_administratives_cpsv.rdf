    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD06587</dct:identifier>
    <dct:title xml:lang="ar">نسخة من كل شهادة من الشهادات المحصل عليها للأشخاص الجدد المقترحين لإجراء المراقبة تؤكد مستوى تكوينهم ومؤهلاتهم</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

