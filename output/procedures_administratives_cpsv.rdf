    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD06538</dct:identifier>
    <dct:title xml:lang="ar">تعريفة الأتعاب المحصل عليها مقابل القيام بعملية أخذ العينات والعد</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD06539">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD06539</dct:identifier>
    <dct:title xml:lang="ar">تقريرين للمراقبة مفصلين خلال مدة التعيين المنصرمة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD06540">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD06540</dct:identifier>
    <dct:title xml:lang="ar">لائحة الزبناء الذين تم لديهم إجراء مراقبة قياس درجات تركيز غبار الحرير الصخري العالق في الجو داخل أماكن العمل عن طريق العد بالمجهر البصري بتعاكس الأطوار خلال مدة التعيين المنصرمة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD06541">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD06541</dct:identifier>
    <dct:title xml:lang="ar">تقرير إجمالي لأنشطة المراقبة خلال مدة التعيين المنصرمة والذي يجب أن يتضمن المعلومات التالية: مرجع تقرير المراقبة (الرقم والتاريخ)؛ تاريخ المراقبة؛ اسم الزبون موضوع المراقبة وعنوان مكان إجرائها؛ الاسم العائلي والشخصي للشخص الذي قام بالمراقبة وعند الاقتضاء، الاسم العائلي والشخصي للشخص أو الأشخاص المرافقين له أثناء المراقبة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD06542">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
