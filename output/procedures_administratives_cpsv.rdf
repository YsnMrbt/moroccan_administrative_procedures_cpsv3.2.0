    <dct:title xml:lang="ar">الهيكل المالي للمشروع: الأموال الخاصة والديون والإعانات والامتيازات المالية</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
