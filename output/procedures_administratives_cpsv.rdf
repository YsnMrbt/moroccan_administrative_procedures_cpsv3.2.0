  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD02095">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD02095</dct:identifier>
    <dct:title xml:lang="ar">وثيقة تبرر قدرة المشتل على إدارة الصحة النباتية ، مثلا : - نسخة من الدبلوم أو شهادة التأهيل للشخص المسؤول عن إدارة الصحة النباتية مصحوبة بالتزام موقع ومصادق عليه بين المسوول عل المشتل والشخص المؤهل (يبين أن الشخص المؤهل مسؤول عن الصحة النباتية) ، أو ؛ - وثيقة تتبت ان المشتل متابع من طرف شخص مؤهل في مجال الصحة النباتية.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD02096">
