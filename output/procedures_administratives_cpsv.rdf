    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00716">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00716</dct:identifier>
    <dct:title xml:lang="ar">أسماء رئيس وأعضاء مجلس الإدارة، أو أسماء رئيس وأعضاء مجلس المراقبة بالنسبة للشركات المجهولة الاسم حسب الحالات</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00717">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00717</dct:identifier>
    <dct:title xml:lang="ar">أسماء مديري وأعضاء مجلس المراقبة بالنسبة لشركات التوصية بالأسهم والشركات ذات المسؤولية المحدودة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00718">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00718</dct:identifier>
    <dct:title xml:lang="ar">أسماء جميع الشركاء بالنسبة لشركات التضامن والشركات ذات المسؤولية المحدودة من دون مجلس مراقبة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00719">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00719</dct:identifier>
    <dct:title xml:lang="ar">أسماء المسيرين المخولين بالإمضاء الاجتماعي، بالنسبة لجميع الشركات</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00720">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00720</dct:identifier>
    <dct:title xml:lang="ar">في حالة تقديم طلب من قبل شركة في طور التأسيس، يجب أن يذكر ذلك مع الإشارة إلى جميع المعلومات المعروفة عن حالة المالك النهائي</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00721">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00721</dct:identifier>
    <dct:title xml:lang="ar">اسم وعنوان وكيل أو ممثل صاحب الطلب في المغرب</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00722">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00722</dct:identifier>
    <dct:title xml:lang="ar">في حالة تقديم طلب الترخيص من قبل شخص طبيعي، يجب على صاحب الطلب الإشارة إلى مهنته وجنسيته ومحل إقامته، ووكيله أو ممثله بالمغرب إذا تطلب الأمر</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00723">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00723</dct:identifier>
    <dct:title xml:lang="ar">الإحداثيات الدقيقة للمنشأة، الموضحة على خريطة طبوغرافية بسلم 50.000/1 أو بأي مقياس ملائم، تشير إلى حدود المنشأة بخطوط موجهة من الشمال إلى الجنوب ومن الشرق إلى الغرب والمنجرفة من نظام إحداثيات لامبير أو الجغرافي</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00724">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00724</dct:identifier>
    <dct:title xml:lang="ar">مصدر الطاقة المتجددة المستخدمة والقوة المستعملة والقدرة الإنتاجية وطريقة استغلال المنشأة والتوافر من حيث مدة التشغيل السنوي والشهري المقدرة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00725">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00725</dct:identifier>
    <dct:title xml:lang="ar">شروط سلامة وموثوقية أشغال الربط بالشبكة الكهربائية الوطنية للنقل والتجهيزات المتعلقة بها وكذا أي خصائص تقنية مطلوبة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00726">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00726</dct:identifier>
    <dct:title xml:lang="ar">البرنامج العام وجدول العمل الذي يعتزم صاحب الطلب تنفيذه خلال فترة إنجاز أو تمديد المنشأة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00727">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00727</dct:identifier>
    <dct:title xml:lang="ar">تقرير حول التأثير على البيئية يصف فيها صاحب الطلب القضايا البيئية الرئيسية للمشروع والتدابير المتوخاة للقضاء، الحد أو، إن أمكن، التعويض عن التأثيرات السلبية للمنشأة على البيئة، وتقدم التقييم التنبؤي لانبعاثات الغازات المسببة للاحتباس الحراري عن طريق التمييز بين العناصر الرئيسية، لا سيما فيما يتعلق بإنشاء أو استغلال أو وقف تشغيل المنشأة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00728">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00728</dct:identifier>
    <dct:title xml:lang="ar">مذكرة مفصلة تتضمن بيان الأعمال المنجزة ونتائجها والنفقات المدفوعة وفقا للالتزام بصرفها</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00729">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00729</dct:identifier>
    <dct:title xml:lang="ar">بيان البرنامج الأدنى للأعمال الذي يلتزم صاحب الطلب بإنجازه لتقييم الاكتشاف الملاحظ</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00730">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00730</dct:identifier>
    <dct:title xml:lang="ar">اقتناء خريطة ذات المقياس 1/250.000 أو بأي مقياس مناسب آخر ترسم فيه حدود الدائرة بخطوط مستقيمة متجهة من الشمال إلى الجنوب ومن الشرق إلى الغرب انطلاقا من نظام إحداثيات لامبير</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00731">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
