  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS00309">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS00309</dct:identifier>
    <dct:title xml:lang="ar">قرار عاملي متعلق بالترخيص باستعمال مركبة في استغلال رخصة سيارة الأجرة</dct:title>
    <dct:description xml:lang="ar">تقدم وزارة الداخلية هذه الخدمة لفائدة المهنيين المغاربة المقيمين بالمغرب بغاية الترخيص باستعمال مركبة كسيارة أجرة وتسوية وضعيتها وكذا تجديد الأسطول وتحسين جودة الخدمات المقدمة. وللحصول على هذا القرار، يشترط أن تكون المركبة تتوفر على الشروط والأوصاف المطلوبة من حيث عدد المقاعد والسن وأن يكون صاحب الطلب مستغلا للرخصة بصفة شخصية أو بواسطة عقد تفويض الاستغلال</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/f3df9503-d376-4eee-be44-0d2efc9e9007/1c0095fd-9513-4639-9faa-9c3fe84369b8"/>
