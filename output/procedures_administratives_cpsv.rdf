  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00511">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00511</dct:identifier>
