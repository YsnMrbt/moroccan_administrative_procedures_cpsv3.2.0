  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01574">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01574</dct:identifier>
    <dct:title xml:lang="ar">التعويض عن مصاريف العلاجات الطبية بالنسبة للمؤسسات الصحية (Expertise)</dct:title>
    <dct:description xml:lang="ar">الغاية : استرداد المصاريف المتعلقة بالعلاجات الطبية المنجزة بالمؤسسات الصحية المعالجة. يخضع هذا القرار لمقتضيات المرسوم رقم 2.22.386 بتحديد لائحة القرارات الإدارية التي تقتضي معالجة الطلبات المتعلقة بها تمديد الأجل القانوني المحدد لتسليمها، لإنجاز خبرة تقنية أو بحث عمومي.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/87a96a4a-06ac-4bfa-b533-a26e4bb4fb33/8b26731d-89d3-45e2-af70-eb586ea29c04"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00008"/>
