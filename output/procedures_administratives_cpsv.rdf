  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01919">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01919</dct:identifier>
    <dct:title xml:lang="ar">رخصة الكفالة بتعهد الشركات المتمركزة داخل مناطق التسريع الصناعي</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة المستفيدين من الحصول على رخصة الكفالة بتعهد الشركات المتمركزة داخل مناطق التسريع الصناعي و ذلك لتغطية عمليات عبور البضائع من و الى هذه المناطق.   و للحصول على هذا الرخصة يتعين القيام بعمليات عبو ر كافية و الإدلاء بشهادة هياة إعداد وإدارة منطقة التسريع الصناعي التي تتواجد بها الشركة تؤكد نشاطها الفعلي.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/ae2dc9f8-8329-438a-b1e3-db95db6ab859"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
