  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD05228">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD05228</dct:identifier>
    <dct:title xml:lang="ar">صورة من عقد الزواج من شخص مغربي أو عقد ولادة مصحوبا بوثيقة تثبت إقامته المستمرة بالمغرب لمدة لا تقل عن 10 سنوات إذا لم يكن الطبيب من مواطني دولة أبرمت اتفاقية مع المغرب تسمح للأطباء من مواطني كل واحدة من الدولتين بمزاولة مهنة الطب بتراب الدولة الأخرى أو تطبق مبدأ المعاملة بالمثل في هذا الشأن.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD05229">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD05229</dct:identifier>
    <dct:title xml:lang="ar">نسخة من كشف الإبحار معتمد يثبت قيام المرشح بخدمة بحرية معتمدة لمدة لا تقل عن اثنتا عشر (12) شهرا بصفة ضابط مسؤول عن الخفارة الهندسية بقسم محركات مطقمة أو غير خاضعة لإشراف دائم وذلك على متن السفن المجهزة بآلات دفع رئيسية قدرتها تعادل أو تفوق750 كيلو واط</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

