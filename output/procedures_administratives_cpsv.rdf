  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00736">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00736</dct:identifier>
    <dct:title xml:lang="ar">طلب مبرر حول حالة تقدم إنجاز المشروع وأسباب التأخير في الإنجاز</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
