    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04450">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04450</dct:identifier>
    <dct:title xml:lang="ar">قائمة لا يتجاوز تاريخها سنة مؤشر عليها بصورة قانونية من قبل الصندوق الوطني للضمان الإجتماعي بمستخدمي الشخص المعني و المنخرطين بالصندوق المذكور.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04451">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04451</dct:identifier>
    <dct:title xml:lang="ar">شهادة تسلمها مصالح الضرائب المباشرة و الرسوم المماثلة تبين رقم المعاملات خلال السنوات الثلاث الأخيرة أو منذ إنطلاق الأنشطة إن كانت قد إبتدأت منذ أقل من ثلاث سنوات.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04452">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04452</dct:identifier>
    <dct:title xml:lang="ar">شهادة مسلمة منذ ما لا يقل عن سنة من عند القابض التابع له مكان فرض الضريبة تشهد أن صاحب الطلب يوجد في وضعية جبائية صحيحة في حالة عدم الأداء أنه قد كون ضمانات يراه المحاسب المكلف بالتحصيل كافية.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04453">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04453</dct:identifier>
    <dct:title xml:lang="ar">المراجع التقنية المتعلقة بطبيعة و مبالغ الخدمات المنجزة و بمكان و تاريخ إنجازها و كذا إسم و موطن أصحاب المشاريع المستفيدين من الخدمات المذكورة أو إن إقتضى الحال تسميتهم و عنوانهم.و لا يعتد إلا بمراجع الخدمات المنجزة مباشرة من طرف المعني بالأمر بإستعمال وسائله الخاصة دون وساطة متعاقد من الباطن.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04454">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04454</dct:identifier>
    <dct:title xml:lang="ar">قائمة بالوسائل المادية مع تحديد مواصفاتها التقنية و بيان تاريخ و مبلغ إقتنائها</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

