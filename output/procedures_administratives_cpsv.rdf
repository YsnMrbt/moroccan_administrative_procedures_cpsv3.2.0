  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS00308">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS00308</dct:identifier>
    <dct:title xml:lang="ar">شهادة الأهلية للاستفادة من منحة تجديد سيارة الأجرة من الصنف الثاني</dct:title>
    <dct:description xml:lang="ar">تسلم وزارة الداخلية هذه الشهادة لفائدة المهنيين المغاربة المقيمين بغاية الحصول على منحة تجديد سيارة الأجرة من الصنف الثاني في أفق تحديث أسطول سيارات الأجرة من الصنف الثاني. وذلك شرط أن يكون سن المركبة 5 سنوات فما فوق وأن تكون قد استعملت كسيارة أجرة لمدة لا تقل عن 3 سنوات</dct:description>
