  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04442">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04442</dct:identifier>
    <dct:title xml:lang="ar">بطاقة تقنية تبين الإسم الشخصي والعائلي لصاحب الطلب أو صفة الشركة ومركزها وإسم مندوبها، نوعية ومحتوى المؤسسة المقرر إنجازها مع تحديد : - طبيعة وصفة المواد المستخدمة - سعة وحجم المواد الأولية والمنتوجات المصنعة - نوعية التخزين - سيرورة ( processus) التصنيع - خاصيات ومميزات المواد ( matières)</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04443">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04443</dct:identifier>
    <dct:title xml:lang="ar">طلب الحصول على شهادة إعتماد الأشخاص الطبيعيين أو المعنويين القائمين بأعمال الدراسات والإشراف على المشاريع</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04444">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
