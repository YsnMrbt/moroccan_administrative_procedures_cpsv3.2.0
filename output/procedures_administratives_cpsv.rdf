  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00618">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00618</dct:identifier>
    <dct:title xml:lang="ar">الإجراء الذي ينبغي القيام به عندما يطول توقف الأنشطة التقنية</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00619">
