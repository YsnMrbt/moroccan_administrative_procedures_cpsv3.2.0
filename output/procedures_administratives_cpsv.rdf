    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COST00621</dct:identifier>
    <cv:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</cv:hasValue>
    <cv:currency rdf:resource="http://publications.europa.eu/resource/authority/currency/MAD"/>
    <dct:description xml:lang="ar">بالمجان</dct:description>
    <cv:isDefinedBy rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00051"/>
