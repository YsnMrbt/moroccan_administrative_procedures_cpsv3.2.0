    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00713">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00713</dct:identifier>
    <dct:title xml:lang="ar">برنامج الأشغال الذي يعتزم صاحب الطلب إنجازه خلال فترة التجديد، متضمنا على وجه الخصوص الجدولة الزمنية للإنجاز.</dct:title>
