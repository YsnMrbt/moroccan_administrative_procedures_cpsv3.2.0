  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01594">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01594</dct:identifier>
    <dct:title xml:lang="ar">الاستفادة من تحمل مصاريف العلاجات الطبية الاستشفائية بالخارج (Expertise)</dct:title>
    <dct:description xml:lang="ar">التحمل المباشر لجزء من مصاريف العلاجات الطبية في حالة الاستشفاء و العمليات الجراحية بالنسبة للحالات المقبولة يخضع هذا القرار لمقتضيات المرسوم رقم 2.22.386 بتحديد لائحة القرارات الإدارية التي تقتضي معالجة الطلبات المتعلقة بها تمديد الأجل القانوني المحدد لتسليمها، لإنجاز خبرة تقنية أو بحث عمومي</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/87a96a4a-06ac-4bfa-b533-a26e4bb4fb33/6ad98f3d-4a7d-4c2a-a2fa-c2d506880eb2"/>
