    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00616</dct:identifier>
    <dct:title xml:lang="ar">وصف الوسائل والإجراءات المتبعة من أجل استغلال أمثل للمنشأة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
