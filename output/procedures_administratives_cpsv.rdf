  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01926">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01926</dct:identifier>
    <dct:title xml:lang="ar">ترخيص القبول المؤقت للسيارات مع الترقيم في السلسلة الخاصة للنظام المؤقت (R.T) من طرف المدرسين الأجانب الذين تم توظيفهم من طرف الوزارة المكلفة بالتعليم بموجب عقد في إطار النظام العام</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة المدرسين الأجانب الذين تم توظيفهم من طرف الوزارة المكلفة بالتعليم بموجب عقد في إطار النظام العام من الاستفادة من القبول المؤقت للسيارات مع الترقيم في السلسلة الخاصة للنظام المؤقت (R.T).  و للحصول على هذا الترخيص يتعين الإدلاء بالوثائق اللازمة لاسيما شهادة مسلمة من طرف وزارة المكلفة بالتعليم و نسخة من عقد العمل في إطار النظام العام.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/20b5e275-e2db-4ce2-a346-5bb130d4e3e6"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00006"/>
