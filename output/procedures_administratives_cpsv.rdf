  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01917">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01917</dct:identifier>
    <dct:title xml:lang="ar">ترخيص توطين طلبات إرجاع المبالغ في ميدان دروباك الطاقة للنسيج والملابس</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة الشركات المصدرة العاملة في قطاع النسيج و الألبسة من تحديد المديرية الجهوية لتوطين طلبات ارجاع المبالغ في ميدان دروباك الطاقة المستهلكة لإنتاج البضائع المصدرة. و يتعلق الأمر بكل من مديرية الجمارك لميناء الدار البيضاء او المديرية الجهوية للدار البيضاء سطات-</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/1744b078-f2ad-49d8-b639-b4bb4982ceb9"/>
