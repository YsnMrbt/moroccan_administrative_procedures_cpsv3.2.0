  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS00128">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS00128</dct:identifier>
    <dct:title xml:lang="ar">شهادة رفع اليد بشأن تعرض قانوني (أجور موظفي وأعوان الدولة)</dct:title>
    <dct:description xml:lang="ar">الاشهاد بمنح رفع اليد على الحساب المصرفي للمعني بالأمر، برسم تعرض منجز لاستخلاص دين عمومي، شريطة سداد الدين موضوع الحجز، قصد الإدلاء بها لأغراض ادارية أو استعمالها كما يجب قانوناً.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/3939a059-1e71-41e8-91d6-0daec1d6c481/8f844002-658f-4d12-b17b-34fdb5950458"/>
