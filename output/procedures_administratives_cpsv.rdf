  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/cost/COST01857">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Cost"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COST01857</dct:identifier>
    <cv:currency rdf:resource="http://publications.europa.eu/resource/authority/currency/MAD"/>
    <dct:description xml:lang="ar">تحدد التكاليف حسب المنتوج وذلك تطبيقا للقرار المشترك لوزير الفلاحة والمالية بتاريخ 28 شتنبر 2017 بتحديد أسعار الخدمات والوثائق المقدمة للغير 
قرار لوزير الفلاحة والتنمية القروية والصيد البحري رقم 1762.04 صادر في 28 من جمادى الأولى 1425 (16 يوليو 2004) بتحديد المقادير المالية التي يتعين استخلاصها من المصدرين والمستوردين للحيوانات والمواد ذات الأصل الحيواني بمراكز الحدود مقابل عمليات المراقبة البيطرية التي تتم بصفة استثنائية خلال أيام العطل وخارج أيام وساعات العمل القانونية لإدارة الجمارك</dct:description>
    <cv:isDefinedBy rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00054"/>
  </rdf:Description>

