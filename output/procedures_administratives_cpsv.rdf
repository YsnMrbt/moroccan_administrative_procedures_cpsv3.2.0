  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS00513">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS00513</dct:identifier>
    <dct:title xml:lang="ar">طلب تغيير الإسم العائلي</dct:title>
    <dct:description xml:lang="ar">تقدم وزارة الداخلية هذه الخدمة لفائدة المغاربة المقيمين بالمغرب أو بالخارج بغاية تغيير الاسم العائلي، وذلك شرط التسجيل بالحالة المدنية وتقديم الحجج التي تعزز طلب التغيير إضافة إلى توجيه طلب إلى كتابة اللجنة العليا للحالة المدنية بوزارة الداخلية. وفي حالة الموافقة على طلب المعني بالأمر يتعين عليه التوجه لمكتب الحالة المدنية الذي يوجد به رسم ولادته من أجل القيام بالتغيير المطلوب</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/27f734c1-797d-400c-98bf-853bf6205b5c/f18db713-f78d-49cb-9c0f-26b5a475404e"/>
