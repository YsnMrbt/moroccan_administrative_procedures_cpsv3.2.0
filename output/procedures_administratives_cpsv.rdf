    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD05152">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD05152</dct:identifier>
    <dct:title xml:lang="ar">نسخة من كشف الإبحار يثبت :• إتمام المرشح لخدمة بحرية معتمدة لمدة لا تقل عن ستة (6) أشهر، تتضمن تدريب تحت الإشراف المباشر من الربان أو الضابط المكلف بالخفارة الملاحية أو الملاح المؤهل ؛ • إتمام المرشح لتدريب خاص سواء قبل صعود السفن أو على متنها، تتضمن مدة معتمدة من الخدمة البحرية لمدة لا تقل عن شهرين (2) تحت الإشراف المباشر من الربان، ضابط مكلف بالخفارة الملاحية أو ملاح مؤهل ؛</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

