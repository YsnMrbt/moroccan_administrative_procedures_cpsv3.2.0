  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01547">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01547</dct:identifier>
    <dct:title xml:lang="ar">طلب منح او تعديل او تجديد الشهادة التقنية للاستغلال</dct:title>
    <dct:description xml:lang="ar">الشهادة التقنية للاستغلال هي رخصة تجيز لمستغل مغربي القيام بخدمات جوية للنقل العام (نقل الركاب والشحن والبريد) وخدمات نقل الأجرة والعمل الجوي. وهي نفس الوثيقة المسماة رخصة الاستغلال الجوي في الملحق رقم 6 من اتفاقية الطيران المدني الدولي الموقعة بشيكاغو بتاريخ 7 ديسمبر 1944وتمكن المرتفق من الحصول على رخصة الاستغلال</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/f3df9503-d376-4eee-be44-0d2efc9e9007/ef72c328-cf2b-4ad9-910d-d15490b6f6b2"/>
