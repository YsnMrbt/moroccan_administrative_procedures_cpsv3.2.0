  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS00272">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS00272</dct:identifier>
    <dct:title xml:lang="ar">ترخيص تخفيض الرسوم لزيارة المعالم التاريخية والمواقع الأثرية بالنسبة لمجموعات التلاميذ والطلبة والجمعيات</dct:title>
    <dct:description xml:lang="ar">استفادة الطلبة والتلاميذ من تحفيزات لزيارة المعالم التاريخية والأثرية واكتشاف تراثهم الثقافي الوطني المادي واللامادي؛ التحسيس بأهمية المحافظة على التراث الثقافي الوطني وترسيخ الهوية الثقافية المغربية في الناشئة من خلال تسهيل الولوج للفضاءات الثقافية واكتشاف الرصيد الأثري والمعماري الوطني؛ المساهمة في دعم الأنشطة الثقافية المنظمة من طرف الجمعيات الغير هادفة لتحقيق ربح من خلال تخفيض رسم التذكرة للزوار المنضوين تحت لوائها.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/304446b1-f64c-45b4-89f5-402afeb46051/887ea5a5-c98d-45e8-8d8e-3debd2a7f1c7"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00027"/>
