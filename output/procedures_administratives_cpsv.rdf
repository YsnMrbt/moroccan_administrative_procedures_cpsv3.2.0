  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01923">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01923</dct:identifier>
    <dct:title xml:lang="ar">رخصة صفة المصدر المعتمد</dct:title>
    <dct:description xml:lang="ar">الحصول على صفة مصدر معتمد تمكن من الإثبات الذاتي لمنشأ السلع المصدرة في إطار اتفاقيات التبادل الحر المبرمة بين المغرب و : - المجموعة الأوربية للتبادل الحر )سويسرا، النرويج، إيسلندا، ليختنشتاين( ؛ - الدول العربية المتوسطية الموقعة على اتفاقية أكادير )مصر، الأردن وتونس( ؛ و - تركيا؛ اتفاقيات الشراكة المبرمة بين المغرب و : - الاتحاد الاوروبي؛ و  - المملكة المتحدة لبريطانيا العظمى. المقاولة المستفيدة من هذه الصفة لا تكون مضطرة لتعبئة مطبوع شهادة الحركة أو شهادة الحركة الأورومتوسطية وتقديمها للمصالح الجمركية لمكتب التصدير للتصديق عليها خلال كل عملية تصدير تقوم بها.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/91adfc7c-26a7-4d7f-992d-024df8b7bb64"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
