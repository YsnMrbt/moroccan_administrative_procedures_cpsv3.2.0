    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00632</dct:identifier>
    <dct:title xml:lang="ar">تصميم وصفي مشفوع بمذكرة توضح على الخصوص مساحة أماكن الإدخار والمسالك المؤدية إليها وأجهزة ضمان السلامة فيها</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00633">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00633</dct:identifier>
    <dct:title xml:lang="ar">الرسم العقاري أو عقدة كراء القطعة الأرضية أو أي وثيقة تثبت حيازة جميع الحقوق الضرورية لاستغلال الارض المخصصة لاتجاز المشروع.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00634">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00634</dct:identifier>
    <dct:title xml:lang="ar">طلب موقع من طرف المستثمر يحدد قائمة الأجزاء المقدمة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00635">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00635</dct:identifier>
    <dct:title xml:lang="ar">دراسة تقنية واقتصادية تحدد بشكل خاص حجم وحدات التعبئة والتخزين المختلفة، مرافق استقبال البوتان التي سيتم تزويد المركز المقترح منها والاستثمارات المخططة وطريقة تمويلها والوظائف التي سيتم إنشاؤها، إلخ.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00636">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00636</dct:identifier>
    <dct:title xml:lang="ar">خريطة للوضع بمقياس1/1000 مع وجود المؤشرات الضرورية على الأرض التي سيتم عليها إنجاز المشروع ( الموقع، السطحية، ... إلخ)</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00637">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00637</dct:identifier>
    <dct:title xml:lang="ar">مذكرة تشير إلى نقطة التزويد للمركز وتحدد اتساق منشآت استقبال غاز البترول المسيل التي سيتم توفيرها في أقرب ميناء، لتجنب أي تكلفة إضافية على صندوق المقاصة من حيث تكاليف نقل البوتان بالجملة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00638">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00638</dct:identifier>
    <dct:title xml:lang="ar">رخصة تنظيم المؤسسات غير الصحية أو غير المريحة أو الخطرة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00639">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00639</dct:identifier>
    <dct:title xml:lang="ar">المستند الأصلي المؤشر: خرائط ووصف تفصيلي للمنشآت المخطط لها ، فيما يتعلق بدوائر التعبئة وكذلك صهاريج التخزين ومحطة ضخ غاز البترول المسال وغسل وصيانة الطلاء للأوعية وأرصفة اختبار و معدات السد و وسائل الصمود والوقاية ضد الحريق</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00640">
