  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04448">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04448</dct:identifier>
    <dct:title xml:lang="ar">الوثائق المثبتة لقيام الشخص الطبيعي صاحب الطلب بإنجاز الخدمات المحددة في المادة 2 من المرسوم رقم 2.98.984</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04449">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
