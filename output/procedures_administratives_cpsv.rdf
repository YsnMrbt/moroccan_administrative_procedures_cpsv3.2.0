  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00553">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00553</dct:identifier>
    <dct:title xml:lang="ar">تصميم الأشغال بسلم 10.000/1 و تصميم سطحي قابل للتراكب مع التصميم السابق</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00554">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00554</dct:identifier>
    <dct:title xml:lang="ar">أصل وصل دفع أجرة عن الخدمات المقدمة، المتعلقة بتجديد رخصة البحث الناتجة عن الدمج (1500 درهم/كلم2)</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00555">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00555</dct:identifier>
    <dct:title xml:lang="ar">الوثائق التي تثبت تمتع الطالب بالمؤهلات التقنية والمالية اللازمة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
