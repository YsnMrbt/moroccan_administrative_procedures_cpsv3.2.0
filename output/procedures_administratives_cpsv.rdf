    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04455</dct:identifier>
    <dct:title xml:lang="ar">قائمة بأعوان الإشراف و التأطير مع تحديد مؤهلاتهم المهنية على الخصوص.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

