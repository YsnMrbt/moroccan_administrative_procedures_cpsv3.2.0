  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01891">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01891</dct:identifier>
    <dct:title xml:lang="ar">ترخيص القبول المؤقت للسيارات مع الترقيم في السلسلة الخاصة للنظام المؤقت (R.T) لفائدة مدارس التعليم الأمريكية</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة مدارس التعليم الأمريكية من الاستفادة من القبول المؤقت للسيارات مع الترقيم في السلسلة الخاصة للنظام المؤقت (R.T) و ذلك في حدود ثلاث سيارات معدة لاستعمال إدارة المدرسة.  و للحصول على هذا الترخيص يتعين الإدلاء بشهادة مسلمة من طرف سفارة الولايات المتحدة بالرباط.  كما أن استيراد سيارات التعويض يتم مقابل تسوية وضعية السيارة التي سيتم تعويضها و التي يجب أن يكون سنها يفوق أربع سنوات.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/a737a1cc-8752-4a3c-9772-59f3120a3f5e"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00006"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07133"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07134"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07135"/>
    <cpsv:produces rdf:resource="http://procedures_administratives_cpsv.ma/id/output/OTPT001839"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_636775641b86"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_636775641b86"/>
    <cv:processingTime rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">P0D</cv:processingTime>
