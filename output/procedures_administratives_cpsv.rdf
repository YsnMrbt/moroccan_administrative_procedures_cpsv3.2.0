  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01921">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01921</dct:identifier>
    <dct:title xml:lang="ar">الترخيص بتفويت لوازم التلفيف وكذا توابعها المعدة للتلفيف بهدف تصدير الفواكه والخضراوات ومنتجات البحر (Invest)</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة المستفيدين من تفويت لوازم التلفيف وكذا توابعها المعدة للتلفيف بهدف تصدير الفواكه والخضراوات ومنتجات البحر و ذلك مع الإعفاء من القيام بإجراءات التفويت شريطة أن يقدم في شأن عمليات التسليم المنجزة في كل شهر مدني تصريح بالتفويت يدلي به المفوت له.  يخضع هذا القرار لمقتضيات المرسوم رقم 2.22.385 بتحديد لائحة القرارات الإدارية اللازمة لإنجاز مشاريع الاستثمار التي لا يتجاوز أجل معالجة الطلبات المتعلقة بها وتسليمها 30 يوما.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/08ae5d0a-9fe8-4217-a7c5-0ef3895f29c4"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00006"/>
    <cpsv:hasInput rdf:resource="http://procedures_administratives_cpsv.ma/id/evidence/EVD07250"/>
    <cpsv:produces rdf:resource="http://procedures_administratives_cpsv.ma/id/output/OTPT001869"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_636775641b86"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_636775641b86"/>
    <cv:hasCost rdf:resource="http://procedures_administratives_cpsv.ma/id/cost/COST01921"/>
    <cv:sector rdf:resource="http://procedures_administratives_cpsv.ma/id/concept/sector/sec_sub_6808a66596ec"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01922">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01922</dct:identifier>
    <dct:title xml:lang="ar">رخصة الكفالة المزدوجة لتغطية العمليات المتعلقة بالأنظمة الاقتصادية الخاصة بالجمارك (Invest)</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة المستفيدين من الحصول على رخصة الكفالة المزدوجة التي تغطي 80% من الرسوم و المكوس المستحقة على البضائع المستوردة لصنع منتجات المقاصة الموجهة للتصدير بينما يجب تقديم كفالة بنكية أو وديعة لتغطية 20% المتبقية من الرسوم و المكوس المستحقة.  يخضع هذا القرار لمقتضيات المرسوم رقم 2.22.385 بتحديد لائحة القرارات الإدارية اللازمة لإنجاز مشاريع الاستثمار التي لا يتجاوز أجل معالجة الطلبات المتعلقة بها وتسليمها 30 يوما.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/af2ac055-8e72-45d9-9091-5ab44fd72cdf"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
