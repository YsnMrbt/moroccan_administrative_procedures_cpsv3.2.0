  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01247">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01247</dct:identifier>
    <dct:title xml:lang="ar">قرار بتغيير ملكية وكالة الأسفار في حالة وفاة صاحب رخصة الوكالة (Invest)</dct:title>
    <dct:description xml:lang="ar">تمكين ذوي حقوق صاحب رخصة وكالة الأسفار المتوفي من الاستمرار في استغلال رخصة وكالة الأسفار من أجل الاستفادة من هذا القرار الإداري يتعين تقديم طلب تغيير ملكية رخصة وكيل الأسفار للورثة خلال مدة سنة بعد وفاة صاحب الرخصة  ويشترط في الشخص الطبيعي الراغب في الاستفادة من هذا القرار أن يبلغ من العمر 23 سنة على الأقل وألا يكون قد خضع لمسطرة التصفية القضائية وأن يكون حاصلا على شهادة السلك الثاني المسلمة من المؤسسات العليا لتكوين الاطر التابعة للسلطة الحكومية المكلفة بالسياحة أو على شهادة معادلة لها معززة بتجربة سنتين بإحدى وكالات الأسفار أو على شهادة السلك الاول من المؤسسات المذكورة "فرع تقنيات الانتاج و البيع" معززة بتجربة أربع سنوات بإحدى وكالات الاسفار أو ان يكون قد شارك في مزاولة أعمال وكالة الاسفار خلال مدة لا تقل عن سبع سنوات بصفة مدير تقني أو تجاري أو رئيس وكالة للأسفار</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/f098d7d4-2268-4f82-b23f-d742deb398c2/175293b1-a038-4704-b3b9-926605e7bb8a"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
