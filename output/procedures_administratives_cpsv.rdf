    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD01078</dct:identifier>
    <dct:title xml:lang="ar">السعر المقترح لخدمة ربط الاتصال وكيفيات الأداء</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
