    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00512</dct:identifier>
    <dct:title xml:lang="ar">أسماء جميع الشركاء فيما يتعلق بشركات التضامن والشركات ذات المسؤولية المحدودة التي ليس لها مجلس مراقبة</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD00513">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD00513</dct:identifier>
