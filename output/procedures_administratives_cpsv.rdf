  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01912">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01912</dct:identifier>
    <dct:title xml:lang="ar">ترخيص الاستفادة من المسطرة المبسطة للتخليص الجمركي للشحنات السريعة</dct:title>
    <dct:description xml:lang="ar">يمكن هذا الترخيص شركات نقل البريد السريع من الاستفادة من المسطرة المبسطة للتخليص الجمركي للشحنات السريعة. للحصول على هذا الترخيص، يجب على شركات نقل البريد السريع الدولي:  - أن تتوفر على الترخيص بمزاولة نشاط البريد السريع الدولي المسلم من طرف وزارة الصناعة و التجارة و الاقتصاد الأخضر و الرقمي: - أن ـتبرم اتفاقية مع بريد المغرب بخصوص شروط مزاولة نشاط البريد السريع الدولي: - أن تقوم بمعالجة شحنات البريد السريع الدولي داخل «مخازن وساحات الاستخلاص الجمركي" التابع لها.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/7f2f9be8-7a15-498f-9f56-4d016bf87e99"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
