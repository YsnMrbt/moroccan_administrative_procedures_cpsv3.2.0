  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD05062">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD05062</dct:identifier>
    <dct:title xml:lang="ar">شهادة متابعة التدريب المتعلق ببحار تقنيات إلكترونية، صادرة عن المعهد العالي للدراسات البحرية أو هيئة معترف بها</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD05063">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD05063</dct:identifier>
    <dct:title xml:lang="ar">نسخة من: • كشف الإبحار إتمام خدمة بحرية معتمدة، تتضمن تدريبا وخبرة لمدة لا تقل عن إثنتا عشر (12) شهرا ؛ أو • كشف الإبحار إتمام تدريب معتمد، يتضمن مدة معتمدة من الخدمة البحرية لا تقل عن ستة (6) أشهر ؛ أو • شهادة تثبت التوفر على المؤهلات المطلوبة لممارسة مهمة بحار تقنيات إلكترونية، مع كشف الإبحار يثبت إتمام فترة معتمدة من الخدمة البحرية لمدة لا تقل عن ثلاثة (3) أشهر في هذا المجال ؛ أو • كشف الإبحار يثبت إتمام خدمة بحرية على متن السفن ذات قوة دفع قدرتها تعادل أو تفوق 750 كيلو واط، بصفة كهربائي، لمدة :  أربعة وعشرون (24) شهرا قبل تاريخ 16 يوليوز 2020 ؛ أو  اثنتا عشر (12) شهرا خلال ستون (60) شهرا السابقة لتاريخ 01 يناير 2012.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

