    <dct:title xml:lang="ar">طلب إيقاف التوطين البنكي (مطبوع مرجع 321-1-10)</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD05231">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD05231</dct:identifier>
    <dct:title xml:lang="ar">نسخة من شهادة ملازم آلاتي من الدرجة الثانية للملاحة التجارية، مسلمة من طرف المعهد العالي للدراسات البحرية أو شهادة أخرى معادلة ومعترف بها</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD05232">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD05232</dct:identifier>
    <dct:title xml:lang="ar">نسخة من كشف الإبحار معتمد يثبت تنفيذ المرشح خلال فترة الخدمة البحرية المطلوبة مهاما ذات صلة بالخفارة الهندسية بقسم المحركات لمدة لا تقل عن ستة (6) أشهر، تحت إشراف ضابط مهندس رئيس أو ضابط مهندس مؤهل</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD05233">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD05233</dct:identifier>
    <dct:title xml:lang="ar">نسخة من كشف الإبحار معتمد يثبت :• إتمام المرشح لتدريب مشترك مع خدمة بحرية معتمدة على متن السفن التجارية المجهزة بآلات دفع رئيسية قدرتها تعادل أو تفوق 750 كيلو، لمدة : إثنتا عشر (12) شهرا على الأقل معترف به في سجل تدريب معتمد من قبل مديرية الملاحة التجارية منها 6 اشهر ينفذ فيها المرشح مهام ذات الصلة يالخفارة الهندسية بقسم المحركات تحت إشراف ضابط مهندس مؤهل ؛ أو  ستة وثلاثين (36) شهرا على الأقل منها ثلاثين (30) شهرا على الأقل من الخدمة البحرية بقسم المحركات ؛أو• إتمام المرشح لتدريب على تقنيات الورشات المشتركة مع خدمة بحرية معتمدة لمدة 36 شهرا على الأقل، منها 30 شهرا في الخدمة البحرية بقسم المحركات و 6 أشهر يقوم فيها المرشح بالمهام ذات الصلة بالخفارة الهندسية بقسم المحركات تحت إشراف ضابط مهندس مؤهل ؛</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD05234">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD05234</dct:identifier>
    <dct:title xml:lang="ar">البطاقة الوطنية للتعريف الالكترونية أو ما يقوم مقامها</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD05235">
