  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01904">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01904</dct:identifier>
    <dct:title xml:lang="ar">ترخيص القبول المؤقت مع الترقيم في السلسلة الخاصة للنظام المؤقت (R.T) لسيارة ثانية لفائدة المتعاونين الأجانب</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة المتعاونين الأجانب من الاستفادة منترخيص القبول المؤقت مع الترقيم في السلسلة الخاصة للنظام المؤقت (R.T) لسيارة ثانية لفائدة.  و للحصول على هذا الترخيص يتعين الإدلاء بالوثائق اللازمة لاسيما نسخة من اتفاقية التعاون الدولي مصادق عليها من طرف المغرب تنص على الاستفادة من نظام القبول المؤقت لسيارة ثانية و كذا شهادة مسلمة من سفارة بلد المتعاون الأجنبي بالرباط تبرر التوظيف بالخارج في اطار اتفاقية تعاون و نسخة من عقد العمل و شهادة العمل مسلمة من طرف الادارة المغربية المعنية. كما يتعين أيضا تسوية وضعية السيارة الأولى.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/f572ece5-3dc6-4254-aeeb-188bb1c395f9"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00006"/>
