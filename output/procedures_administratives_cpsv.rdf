  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01903">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01903</dct:identifier>
    <dct:title xml:lang="ar">ترخيص العربات من أجل النقل الدولي للبضائع عبر الطرق تحت الأختام الجمركية</dct:title>
    <dct:description xml:lang="ar">بموجب هذا الترخيص تصبح العربة مؤهلة لإنجاز عمليات النقل الدولي تحت غطاء دفتر التير.  للحصول على هذا الترخيص، يجب على كل من الناقل الطرقي و عربات النقل التي يمتلكها أن تستوفي الحد الأدنى للشروط و المتطلبات المنصوص عليها في المرفق 9 من الاتفاقية الجمركية للنقل الدولي للبضائع تحت غطاء دفتر التير. كما يستوجب الحصول على ترخيص مسبق من طرف الجمعية الضامنة لدفتر التير في المغرب (الجمعية المغربية للنقل الدولي الطرقي).</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/bc7656ef-1ac0-43d8-99bf-27523f5c60ad"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
