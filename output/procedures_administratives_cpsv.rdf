  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01582">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01582</dct:identifier>
    <dct:title xml:lang="ar">تمديد الاستفادة من نظام التأمين الاجباري الأساسي عن المرض. CNOPS</dct:title>
    <dct:description xml:lang="ar">تمديد الاستفادة من الخدمات المضمونة في إطار نظام التأمين الاجباري الأساسي عن المرض.   مع ضرورة توفر شروط تمديد الاستفادة من الخدمات المضمونة في إطار نظام التأمين الاجباري الأساسي عن المرض. ويستفيد من هذا القرار المؤمنون الخاضعون لأنظمة التأمين الإجباري الأساسي عن المرض التي يدبرها الصندوق الوطني لمنظمات الاحتياط الاجتماعي وأجراء ومتقاعدو القطاع العام. وكذا ضحايا الانتهاكات الجسيمة لحقوق الإنسان.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/87a96a4a-06ac-4bfa-b533-a26e4bb4fb33/aebca42d-f5e2-424f-829c-826af3581a5d"/>
