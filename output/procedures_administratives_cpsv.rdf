    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04503</dct:identifier>
    <dct:title xml:lang="ar">برنامج التكوين المستمر مدته ثلاث سنوات لصالح الأشخاص المكلفين بالمراقبة مرفقة بالتزام صاحب الطلب بتطبيقه، موقع ومختوم.</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
