  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01760">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01760</dct:identifier>
    <dct:title xml:lang="ar">الترخيص بالاستفادة من رسم الاستيراد الأدنى بنسبة %2.5 على المواد و المعدات و السلع المستوردة من طرف مؤسسة محمد السادس للنهوض بالأعمال الاجتماعية للتربية و التكوين في إطار المهام المنــــوطة بـــــها</dct:title>
    <dct:description xml:lang="ar">الغاية من المسطرة هي استفادة مؤسسة محمد السادس للنهوض بالأعمال الاجتماعية للتربية و التكوين من رسم الاستيراد الأدنى بنسبة %2.5 . ويشترط أن يتعلق الأمر بمواد و معدات و سلع مستوردة في إطار المهام المنــــوطة بـــــالمؤسسة.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/22c7ee99-87af-4a65-813c-6f021fb55256/162e3831-1677-4541-97a3-e70b8d9cfeb6"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
