    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04496">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04496</dct:identifier>
    <dct:title xml:lang="ar">طلب يحمل توقيع وخاتم المركز</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04497">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04497</dct:identifier>
    <dct:title xml:lang="ar">ملف اداري:طلب الاعتماد موقع من مدير المصحة و من طرف المسؤول عن وحدة الزرع -مسطرة مكتوبة للوحدة المكلفة بالزرع -وثيقة تثبت توفر المقر على مكان لحفظ الخلايا الجذعية</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04498">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04498</dct:identifier>
    <dct:title xml:lang="ar">ملف العاملين الطبيين:عقد عمل المدير بالمصحة- التزام موقع من طرف المسؤول عن وحدة الزرع بوقت كامل- دبلوم الاختصاص في الامراض الدم السريرية للمسؤول عن الوحدة- شهادة التكوين في مجال الزرع مسلمة من مستشفى عمومي معتمد لهدا الغرض- عقد عمل المسؤول عن الوحدة موقع من طرفه و من طرف مدير المصحة -مقرر التسجيل في لائحة الأطباء الاختصاصيين للهيئة الوطنية للأطباء المخول لهم العمل بالقطاع الخاص- مقرر التسجيل في لائحة الأطباء الاختصاصيين - عقد عمل أطباء التخدير و الإنعاش (2 على الأقل)- دبلوم التخصص - شهادة التكوين في مجال التكفل بالمريض قبل و بعد عملية الزرع- مقرر التسجيل في لائحة الأطباء الاختصاصيين في التخدير والانعاش للهيئة الوطنية للأطباء المخول لهم العمل بالقطاع الخاص.-</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04499">
    <rdf:type rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVD04499</dct:identifier>
    <dct:title xml:lang="ar">ملف العاملين شبه الطبيين:السيرة الذاتية لأفراد الفريق الشبه طبي-عقود عمل أفراد الفريق شبه الطبي - شهادة التكوين في مجال التكفل بالمريض قبل وبعد عملية الزرع - نسخة من بطاقة التعريف الوطنية-</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/evidence/EVD04500">
