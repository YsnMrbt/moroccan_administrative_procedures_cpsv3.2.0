  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01902">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01902</dct:identifier>
    <dct:title xml:lang="ar">رخصة الكفالة بتعهد الشركات المصدرة (Invest)</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة المستفيدين من الحصول على رخصة الإعفاء من كفالة الرسوم و المكوس المستحقة لاستيراد البضائع لصنع منتجات المقاصة الموجهة للتصدير.  و للحصول على هذا الترخيص يتعين على الخصوص التوفر على الأدوات و المعدات اللازمة لعمليات الصنع أو الصياغة أو تكملة الصنع المزمع القيام بها و إنجاز عمليات في إطار الأنظمة الاقتصادية بوتيرة منتظمة و التوفر على رأس مال اجتماعي يتجاوز 000 500 درهم و تحقيق رقم معاملات للتصدير يتجاوز 10000000 درهم و التوفر مسبقا على الكفالة المزدوجة. و تجدر الإشارة أن الشرط الأخير لا ينطبق على الشركات التي تتوفر على صفة الفاعل الاقتصادي المعتمد.  يخضع هذا القرار لمقتضيات المرسوم رقم 2.22.385 بتحديد لائحة القرارات الإدارية اللازمة لإنجاز مشاريع الاستثمار التي لا يتجاوز أجل معالجة الطلبات المتعلقة بها وتسليمها 30 يوما.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/0160acd4-0a71-48d0-82cf-69814e433343"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
