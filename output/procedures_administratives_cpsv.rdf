  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01715">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01715</dct:identifier>
