    <dct:title xml:lang="ar">الإجراء الذي يجب القيام به لحماية المنشأة في حالة توقف الأنشطة التقنية</dct:title>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
