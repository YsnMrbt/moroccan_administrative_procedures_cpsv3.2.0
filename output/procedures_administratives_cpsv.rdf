  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS01899">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01899</dct:identifier>
    <dct:title xml:lang="ar">رخصة فتح مستودع الادخار حر خصوصي خاص بالوقود (Invest)</dct:title>
    <dct:description xml:lang="ar">تمكن هذه المسطرة الشركات من الحصول على رخصة فتح مستودع الادخار حر خصوصي و ذلك من أجل ادخار الوقود مؤقتا مع وقف الرسوم و المكوس المستحقة. للحصول على هذا الترخيص يجب أن يكون بناء وتهيئة الأماكن المستعملة لإيداع البضائع مطابقين لتصميم الموضع والتهيئة المرفق بالملف، و يستجيبان للشروط اللازمة لسلامة و حفظ للبضائع المودعة وكذا عمليات المراقبة الجمركية. كما يجب إرفاق الملف بترخيص مسلم من طرف القطاع المكلف بالطاقة، وكذا بالوثائق التقنية المتعلقة بمقادير ووسائل قيس الأحواض.  يخضع هذا القرار لمقتضيات المرسوم رقم 2.22.385 بتحديد لائحة القرارات الإدارية اللازمة لإنجاز مشاريع الاستثمار التي لا يتجاوز أجل معالجة الطلبات المتعلقة بها وتسليمها 30 يوما.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/b3474738-7692-4d17-ba66-6991dead4a30/4ca0f829-f41d-4f58-b360-4b01b2aa5e50"/>
