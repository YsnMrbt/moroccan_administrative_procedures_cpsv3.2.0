  <rdf:Description rdf:about="http://procedures_administratives_cpsv.ma/id/public_service/PS00084">
    <rdf:type rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS00084</dct:identifier>
    <dct:title xml:lang="ar">شهادة الاستفادة من تعويضات صندوق الزيادة في الإيراد</dct:title>
    <dct:description xml:lang="ar">تمكين المرتفق من شهادة تبين الزيادة في الإيراد المستحقة له على رأس كل دورة و سنويا مع تبيان طريقة الأداء  يجب أن يكون المرتفق يستفيد من الزيادة في إيراد حادثة شغل، أن يكون الطلب موجها من طرف المرتفق صاحب الإيراد و أن يكون الأداء غير متوقف  يمكن توجيه طلب الاستفادة من تعويضات صندوق الزيادة في الإيراد إلى الصندوق الوطني للتقاعد و التأمين عبر البريد الإلكتروني إلى العنوان الإلكتروني : www.cnra.ma   أو عبر رسالة إلى العنوان البريدي: مركز الأعمال، شارع النخيل ص.ب 2173 حي الرياض، الرباط  أو التقدم شخصيا إلى أية وكالة من وكالات الصندوق المتواجدة بالرباط، الدار البيضاء، جرادة و العيون   أو عبر الإتصال بمركز النداء رقم 0801001517.</dct:description>
    <foaf:isPrimaryTopicOf rdf:resource="https://procedures_administratives_cpsv.ma/informationnel/ar/thematique/780e2a00-ce2f-46e5-883a-65a00bcc71f7/d594b410-a970-4b12-b4f8-7e05f23ff1b9"/>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ARA"/>
    <dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MAR"/>
    <cv:hasCompetentAuthority rdf:resource="http://procedures_administratives_cpsv.ma/id/organisation/CA00012"/>
    <cpsv:produces rdf:resource="http://procedures_administratives_cpsv.ma/id/output/OTPT000084"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_bde3257cc324"/>
    <cv:hasChannel rdf:resource="http://procedures_administratives_cpsv.ma/id/channel/chan_bde3257cc324"/>
    <cv:processingTime rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">P15D</cv:processingTime>
